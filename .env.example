# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=postgresql+psycopg://nobs:nobs@localhost:5432/nobs_ai
REDIS_URL=redis://localhost:6379/0

# "local" (default, free, but doesn't survive a redeploy on ephemeral disk
# — fine for local dev, NOT fine on Render) or "supabase" (uploads finished
# artifacts to Supabase Storage so they survive redeploys).
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage/local

# --- Supabase Storage (only used when STORAGE_BACKEND=supabase) ---
# Project URL and service_role key from Supabase dashboard -> Project
# Settings -> API. The bucket must already exist and be set Public.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=nobs-ai

# Drop tracks you've downloaded from YouTube Audio Library here (no public
# API to pull them automatically) — NOBS AI rotates through them without
# repeating. Empty/missing folder just means videos assemble without music.
MUSIC_LIBRARY_PATH=./storage/music

# Origins allowed to call the API (comma-separated). Default matches the
# Vite dev server for apps/web.
CORS_ORIGINS=http://localhost:5173

# --- LLM (script/research, and the video-creation Assistant chat) ---
# Leave unset until a provider + cost is approved. Script/research engines
# will raise a clear error rather than silently calling a paid API. Only
# "anthropic" is implemented — see services/ai/*/engine.py.
LLM_PROVIDER=
LLM_API_KEY=
# Defaults to claude-opus-5. Set a cheaper model (e.g. claude-sonnet-5,
# claude-haiku-4-5) to cut cost — see chat history for the price comparison.
LLM_MODEL=claude-opus-5

# --- Video engine (Wan / Runpod) ---
# Unset by default. Provisioning Runpod is a paid, approval-required action.
RUNPOD_API_KEY=
WAN_ENDPOINT_ID=

# --- Voice engine ---
# "chatterbox" (default — self-hosted, free per call but needs an
# already-running server, so it bills for uptime not usage) or
# "elevenlabs" (managed, usage-based, no idle cost).
VOICE_PROVIDER=chatterbox
# Self-hosted Chatterbox server URL, once one is running locally/approved.
CHATTERBOX_API_URL=
# --- ElevenLabs (only used when VOICE_PROVIDER=elevenlabs) ---
ELEVENLABS_API_KEY=
# JSON object mapping voice_preset ids (services/voice/catalog.py) to real
# ElevenLabs voice_ids, e.g. {"warm-narrator":"<voice_id>","energetic-host":"<voice_id>"}
ELEVENLABS_VOICE_MAP={}

# --- Connectors (admin assistant only — see services/connectors) ---
# GitHub: Settings -> Developer settings -> Fine-grained tokens -> new
# token, scoped to ONLY this one repo, with ONLY Contents (read/write) and
# Pull requests (read/write) permissions. Writes always land on a new
# branch + PR — never pushed straight to the default branch.
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=
# Vercel: Account Settings -> Tokens -> new token, scoped to one project
# if your plan supports it. Read-only on deployments; can add/update env
# vars, never triggers a deploy or touches domains.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Gmail: OAuth only (no plain API key exists for Gmail) — one-time setup
# in Google Cloud Console: create a project, enable the Gmail API,
# configure the OAuth consent screen, create an OAuth Client ID (Desktop
# app type is simplest), then run a one-time local authorization flow to
# get a refresh token. Drafts only — this can never send an email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Auth ---
# Peppers PIN-code and session-token hashes. Required for signup/login to
# work at all — generate a real random value, never reuse this example.
SECRET_KEY=
# Bootstraps the one ADMIN account on first startup. Only used when no
# ADMIN user exists yet in the database.
ADMIN_EMAIL=
ADMIN_PASSWORD=
