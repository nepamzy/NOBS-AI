# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=postgresql+psycopg://nobs:nobs@localhost:5432/nobs_ai
REDIS_URL=redis://localhost:6379/0

# Local filesystem storage backend (default, free). Switch to "s3" later
# only after an explicit cost-approved decision (see CLAUDE.md Part 1).
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=./storage/local

# Origins allowed to call the API (comma-separated). Default matches the
# Vite dev server for apps/web.
CORS_ORIGINS=http://localhost:5173

# --- LLM (script/research) ---
# Leave unset until a provider + cost is approved. Script/research engines
# will raise a clear error rather than silently calling a paid API.
LLM_PROVIDER=
LLM_API_KEY=

# --- Video engine (Wan / Runpod) ---
# Unset by default. Provisioning Runpod is a paid, approval-required action.
RUNPOD_API_KEY=
WAN_ENDPOINT_ID=

# --- Voice engine (Chatterbox) ---
# Self-hosted Chatterbox server URL, once one is running locally/approved.
CHATTERBOX_API_URL=
